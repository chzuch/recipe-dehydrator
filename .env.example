# LLM provider 配置（复制为 .env 并填写真实 key；.env 不入库）
# 主用 DeepSeek；Qwen / Kimi 作为可切换 provider

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Qwen (DashScope 兼容 OpenAI 格式)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Kimi (Moonshot)
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

# 默认使用的 provider: deepseek | qwen | kimi
LLM_PROVIDER=deepseek

# B站登录 cookie 文件（Netscape cookies.txt 格式，可选）
# 未配置时无法获取 B站字幕（官方/AI 字幕都需要登录态）。
# 获取方法：浏览器登录 B站后，用扩展导出 cookies.txt（如 "Get cookies.txt LOCALLY"）。
# 注意：cookie 会过期，过期后需重新导出；不要把这个文件提交到 git（已在 .gitignore）。
# 放在项目根（不要放 data/——那是运行产物目录，清理时会被删除）。
BILIBILI_COOKIE_FILE=cookies.txt
